# Example environment configuration for the CollegeAI Chatbot project

# ------------------------------------------------------------
# Backend (FastAPI) configuration
# ------------------------------------------------------------
# Application settings
ENVIRONMENT=development
APP_NAME=CollegeAI Backend - Data Science Department
APP_VERSION=2.0.0
DEBUG=true

# Department configuration (Data Science focus)
DEPARTMENT=DS
DEPARTMENT_NAME=Data Science
DEPARTMENT_FULL_NAME=Department of Data Science
FILTER_BY_DEPARTMENT=true

# College information (replace with your institution's details)
COLLEGE_NAME=Saraswati College of Engineering
COLLEGE_LOCATION=Kharghar, Navi Mumbai
COLLEGE_WEBSITE_URL=https://www.scoe.edu.in

# Database connection (SQLAlchemy compatible URL)
# Example for PostgreSQL: postgresql://user:password@localhost:5432/collegeai
DATABASE_URL=postgresql://user:password@localhost:5432/collegeai

# JWT authentication
SECRET_KEY=change_me_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Admin secret (used for privileged actions)
ADMIN_SECRET_KEY=change_me_admin_secret

# Email settings (used for OTP and password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_ADDRESS=your_email@example.com
EMAIL_PASSWORD=your_email_password

# AI / LLM integration (Groq API key example)
GROQ_API_KEY=your_groq_api_key

# Web search configuration (optional)
ENABLE_WEB_SEARCH=true
SERPAPI_KEY=your_serpapi_key
BRAVE_API_KEY=your_brave_api_key

# File upload settings
UPLOAD_DIR=data
MAX_UPLOAD_SIZE_MB=50

# CORS allowed origins (add your frontend URL if needed)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------
# Frontend (Vite/React) configuration
# ------------------------------------------------------------
# The frontend expects the backend API URL via VITE_API_URL
VITE_API_URL=http://localhost:8000
VITE_APP_TITLE=CollegeAI Chatbot

# End of example configuration
